# ---- ACA runtime ----
ACA_ENV=dev                           # dev | staging | prod
ACA_PORT=8002
ACA_LOG_LEVEL=INFO

# ---- ACA app data and LangGraph checkpoints ----
ACA_DATABASE_URL=postgresql+psycopg://user:pass@host/aca_app?sslmode=require
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://user:pass@host/aca_checkpoint?sslmode=require
ACA_COOKIE_SECURE=false             # Set true when served over HTTPS

# ---- AImpact development data reader (read-only) ----
DATABASE_URL=postgresql://user:pass@host/aimpact_db?sslmode=require

# ---- AImpact API client (server-to-server) ----
AIMPACT_BASE_URL=https://api.aimpact.example.com
AIMPACT_API_TOKEN=at_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIMPACT_TIMEOUT_S=30

# ---- LLM (Claude only) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SONNET=claude-sonnet-5

# ---- Agent 3 web search (Exa) ----
EXA_API_KEY=your-exa-api-key

# ---- WordPress publish target (per-tenant, KMS-encrypted at rest) ----
# The env vars here are only for local dev. Prod values come from Secrets Manager.

# ---- Secrets / KMS ----
AWS_REGION=ap-south-1
AWS_KMS_KEY_ID=alias/aca-secrets

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ---- Cost guard rails ----
ACA_DAILY_USD_CAP_PER_TENANT=25
ACA_JOB_TIMEOUT_S=900
ACA_MAX_REVISE_LOOPS=2
